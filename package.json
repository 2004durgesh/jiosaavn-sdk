{
  "name": "jiosaavn",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:docs": "npm run dev -w apps/docs",
    "build:sdk": "npm run build -w packages/sdk",
    "test:sdk": "npm run test -w packages/sdk",
    "typecheck:sdk": "npm run typecheck -w packages/sdk",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "lefthook": "^2.1.1",
    "prettier": "^3.8.1",
    "release-it": "^21.1.1"
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.1"
    },
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  }
}
